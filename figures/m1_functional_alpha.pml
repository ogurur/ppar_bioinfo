# Conserved Method 1 clusters (>=30%) and functional regions on 1K7L
# run from the project folder:  @figures/m1_functional_alpha.pml
reinitialize
load data/raw/PPARalpha/1k7l.cif, ref
remove ref and not chain A
remove ref and resn HOH
bg_color white
hide everything
show cartoon, ref
color grey90, ref
set cartoon_transparency, 0.2
select pocket, ref and resi 279+280+314+358+440+464
select af2, ref and resi 284+285+288+289+292+295+297+302+303+305+306+309+310+457+458+459+460+461+462+463+464+465+466+468
select rxr, ref and resi 364+386+387+389+394+398+401+402+405+409+420+421+423+424+425+427+428+430+431+432+434+435+438+442
select selectivity, ref and resi 245+345
color lightorange, af2
color palecyan, rxr
show sticks, pocket and not name N+C+O
color orange, pocket and elem C
show sticks, selectivity and not name N+C+O
color violet, selectivity and elem C
load figures/method1_clusters_alpha.pdb, sites
hide everything, sites
set sphere_scale, 0.4
show spheres, sites and resi 1
color red, sites and resi 1
show spheres, sites and resi 3
color red, sites and resi 3
show spheres, sites and resi 2
color red, sites and resi 2
label sites and resi 2, "C2"
